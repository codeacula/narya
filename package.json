{
  "name": "streamer-tools",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "types": "build/ts/index.d.ts",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "STREAMER_TOOLS_REDIS_PREFIX=dev bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@twurple/auth": "^8.2.0",
    "@twurple/chat": "^8.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.1.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.2"
  }
}
